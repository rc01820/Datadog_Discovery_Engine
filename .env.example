# Copy to .env (or run ./scripts/init-env.sh to generate random secrets).
HTTP_PORT=8080

# First administrator (created on first start only). 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# 32+ random characters each, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-64-hex-chars
DATA_ENCRYPTION_KEY=replace-with-64-hex-chars
POSTGRES_PASSWORD=replace-with-a-random-password

# Set true when served over HTTPS (behind a TLS reverse proxy).
COOKIE_SECURE=false

# Where change-history archives (gzip CSV) are written before roll-off, when archiving is enabled in
# Admin › Settings. Default: the Docker volume "history_archive". To use a host folder instead:
#   mkdir -p ./archive && sudo chown 10001:10001 ./archive   (Linux; not needed on Docker Desktop)
#   HISTORY_ARCHIVE_PATH=./archive
# HISTORY_ARCHIVE_PATH=

# Seed explorable synthetic DEMO inventory on first start.
DEMO_DATA=true

# Datadog connection. Keys can also be entered in Admin > Datadog Config (stored encrypted).
# Sites: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com, ap2.datadoghq.com, ddog-gov.com
DATADOG_SITE=datadoghq.com
DATADOG_ORG=default
DATADOG_API_KEY=
DATADOG_APP_KEY=
